[Unit]
Description=EV load balancer (Shelly Pro 3EM -> DEFA Power)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{INSTALL_DIR}}/.venv/bin/python -m ev_balancer.main --config {{INSTALL_DIR}}/config.yaml
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# The service only needs network access (Modbus TCP to the chargers, HTTP
# to the Shelly) and, besides persisting the dashboard's live charger list
# to state/, never writes to disk, so it can run mostly read-only/sandboxed.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{INSTALL_DIR}}/state

[Install]
WantedBy=multi-user.target
